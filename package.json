{
  "name": "tack",
  "productName": "Tack",
  "version": "1.1.1",
  "description": "A minimalist desktop to-do widget. Frameless, hotkey-summoned, paper-aesthetic.",
  "main": "main.js",
  "author": "willshow63",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "icns": "node scripts/make-icns.js",
    "build:mac": "npm run icns && electron-packager . Tack --platform=darwin --arch=universal --out=dist --overwrite --icon=icon.icns --app-bundle-id=com.willshow63.tack",
    "pack": "electron-builder --dir"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@electron/universal": "^3.0.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "png2icons": "^2.0.1"
  },
  "build": {
    "appId": "com.willshow63.tack",
    "productName": "Tack",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "styles.css",
      "icon.png",
      "icon.ico",
      "iconTemplate.png",
      "iconTemplate@2x.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "mac": {
      "target": "zip",
      "icon": "icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "LSUIElement": true
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "menuCategory": "Productivity",
      "shortcutName": "Tack",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico"
    }
  }
}
